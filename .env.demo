# Settings of the demo build (npm run build:demo, Vite mode "demo"), which publishes the
# landing page and the live demo to docs/ (inscript.harshankur.com). Vite reads this file
# after .env, so these values win over a local .env.

TITLE=Inscript

FOOTER_COPYRIGHT_HOLDER=Harsh Ankur
FOOTER_COPYRIGHT_URL=https://harshankur.com
FOOTER_COPYRIGHT_YEAR=2026
FOOTER_LEGAL_NOTICE_URL=https://harshankur.com/impressum
# Quoted: unquoted, "#" would start a comment.
FOOTER_PRIVACY_URL="https://harshankur.com/datenschutz#en-inscript"
