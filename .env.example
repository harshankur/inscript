# Inscript Environment Template
# NOTE: All the directory paths are relative to inscript/ directory or absolute paths.

# --- General ---
# Title shown in the browser tab and sidebar
# Default: My Inscript Blog
TITLE=My Inscript Blog

# Used in sitemap and robots.txt
# Default: https://example.com
SITE_URL=https://example.com

# --- MUST BE SET ---
# Content directory - where markdown files are stored.
# Default: ../content
CONTENT_DIR=../content

# Static directory - where static files like the images used in the posts are stored.
# Default: ../static
STATIC_DIR=../static

# --- OPTIONAL ---
# Favicon path - the icon shown in the browser tab and sidebar.
# Default: assets/favicon_default.png
FAVICON=assets/favicon_default.png

# Drafts directory - where drafts which are autosaved or unpublished are stored.
# Default: ../drafts
DRAFTS_DIR=../drafts

# Output directory - where the generated files are stored.
# Default: ../dist
DIST_DIR=../dist

# Port for the Inscript Server
# Default: 3001
SERVER_PORT=3001

# Port for the Inscript Client (Dev mode)
# Default: 5173
CLIENT_PORT=5173

# Hostnames allowed to access the Inscript client (comma-separated or 'true' to allow all).
# Default: true
ALLOWED_HOSTS=true

# --- Authentication & Security ---
# Enable local password authentication
# Default: true
AUTH_ENABLED=true

# Admin username for login
# Default: admin
AUTH_USERNAME=admin

# BCrypt hash of your password (Generated on first run)
AUTH_PASSWORD_HASH=

# Secret for signing session cookies (Generated on first run). Required while AUTH_ENABLED
# is true: the server refuses to start without it.
SESSION_SECRET=

# How long a sign-in lasts, in hours: a number from 0.25 to 8760 (a year), such as 12 or 0.5.
# Default: 24. The sign-in ends that long after it began, however much you use the editor.
# The server refuses to start on any other value.
SESSION_MAX_AGE_HOURS=

# Other sites allowed to call the API (comma-separated origins such as https://cms.example.com).
# Default: none. The editor reaches the API through its own address and needs no entry.
CORS_ORIGINS=

# --- Footer ---
# The footer shown under every screen (an open post, the home screen, the login screen):
# a line of legal links, then "Powered by Inscript", then the copyright line
#   <TITLE> © <FOOTER_COPYRIGHT_YEAR> <FOOTER_COPYRIGHT_HOLDER>
# Everything here is optional. Unset parts are left out: with no holder and no year there is
# no copyright line, and a legal link only appears when its URL is set. URLs must be absolute
# http(s) URLs (setup refuses anything else); put one that contains "#" in double quotes,
# or the rest is read as a comment. Links open in a new tab.

# Name in the copyright line, e.g. your name or company.
FOOTER_COPYRIGHT_HOLDER=

# Link for that name (optional).
FOOTER_COPYRIGHT_URL=

# Year in the copyright line: the year the site was first published, fixed, e.g. 2026.
FOOTER_COPYRIGHT_YEAR=

# Your legal notice (Impressum) page, e.g. https://example.com/impressum
FOOTER_LEGAL_NOTICE_URL=

# Fixed text of that link, in every language. Default: the visitor's language
# ("Legal notice" in English, "Impressum" in German).
FOOTER_LEGAL_NOTICE_LABEL=

# Your privacy notice (Datenschutzerklärung) page, e.g. https://example.com/datenschutz
FOOTER_PRIVACY_URL=

# Fixed text of that link, in every language. Default: the visitor's language
# ("Privacy" in English, "Datenschutz" in German).
FOOTER_PRIVACY_LABEL=

# The privacy notice for visitors of other languages, when it is written in several, as
# comma-separated <language>=<URL> pairs, e.g. de=https://example.com/datenschutz
# A visitor whose language is listed gets that address (the footer, the YouTube placeholder and the
# counting question alike), everyone else FOOTER_PRIVACY_URL. Put it in double quotes when a URL
# contains "#".
FOOTER_PRIVACY_URLS=

# --- View counting ---
# Counts page views on the published site with viewcounter (https://viewcounter.harshankur.com),
# a privacy-first view counter you run yourself. Off while VIEWCOUNTER_URL and
# VIEWCOUNTER_APP_ID are unset; set both or neither. When on, the published site loads your
# instance's consent.js, which asks each visitor before anything runs in their browser to count
# them, and the footer gets a "Privacy settings" button that asks again. Each post counts as its
# own page (/?post=<name>); the question is only asked on SITE_URL's hostname, never on a
# preview, and never in the editor. Describe the counting in your privacy notice
# (FOOTER_PRIVACY_URL), which the question links to.

# Where your viewcounter instance runs, e.g. https://views.example.com
VIEWCOUNTER_URL=

# The app ID your blog's views are stored under, as listed in the instance's allowed.json
# (with SITE_URL among its origins), e.g. blog
VIEWCOUNTER_APP_ID=

# true when viewcounter's edge Worker stands in front of the site and counts requested pages
# without the visitor's consent; the question then says so. Default: false (without the
# visitor's yes, nothing is counted).
VIEWCOUNTER_EDGE=

# Who runs the site, e.g. your name or company: the consent question then starts with "This site
# is run by <name>." Optional; unset, the question names no one. Not taken from
# FOOTER_COPYRIGHT_HOLDER, since who holds the copyright is not always who runs the site, so set
# both when they are the same. One line, up to 100 characters. Needs a viewcounter whose consent.js
# knows data-operator; an older one ignores it.
VIEWCOUNTER_OPERATOR=

# --- Experimental Features ---
# Allow push to remote after publishing
# Default: false
ALLOW_PUSH=false
